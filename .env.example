# ---------------------------------------------------------------------------
# Enquiry email delivery (contact + quote forms)
#
# Gmail needs an APP PASSWORD, not the account password:
#   1. Turn on 2-Step Verification on the Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an app password and paste the 16 characters below (no spaces)
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=thescrapdepot@gmail.com
SMTP_PASS=

# Where enquiries are delivered (defaults to site.email if unset)
MAIL_TO=thescrapdepot@gmail.com

# Display name on the "From" line. The address itself is always SMTP_USER,
# because Gmail will not let you send as an address you have not verified.
MAIL_FROM_NAME=Scrap Depot Website
